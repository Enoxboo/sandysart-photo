# Port d'écoute du serveur Express
PORT=5000

# development | production — active certains comportements (CORS, détails d'erreur)
NODE_ENV=development

# Secret utilisé pour signer/vérifier les JWT — générer une valeur aléatoire longue
# (ex: openssl rand -hex 32) et ne JAMAIS la committer.
JWT_SECRET=change_me

# Identifiants du compte admin unique. ADMIN_PASSWORD_HASH est un hash bcrypt
# généré via `node backend/scripts/hashPassword.js "VotreMotDePasse"`.
ADMIN_USERNAME=change_me
ADMIN_PASSWORD_HASH=change_me

# Compte utilisé pour envoyer les messages du formulaire de contact (nodemailer,
# service "hotmail"). CONTACT_EMAIL_PASSWORD est un mot de passe d'application
# généré dans les paramètres de sécurité du compte Microsoft si le 2FA est actif.
CONTACT_EMAIL=change_me
CONTACT_EMAIL_PASSWORD=change_me
